const KEY="imaginaryCurrencyApp_v1";
const defaults={
  title:"My Rewards", currencyName:"Stars", currencyIcon:"⭐", balance:0,
  rewards:[
    {id:1,name:"Movie night",price:1500},
    {id:2,name:"Pick dinner",price:500},
    {id:3,name:"Big reward",price:5000}
  ], history:[]
};
let state=load(), editingRewardId=null, amountMode="add";

function load(){
  try{return {...defaults,...JSON.parse(localStorage.getItem(KEY))}}catch{return structuredClone(defaults)}
}
function save(){localStorage.setItem(KEY,JSON.stringify(state)); render()}
function fmt(n){return new Intl.NumberFormat().format(n)}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[c]))}
function toast(msg){const t=document.getElementById("toast");t.textContent=msg;t.classList.add("show");setTimeout(()=>t.classList.remove("show"),1800)}
function addHistory(amount,reason,kind){
  state.history.unshift({id:Date.now()+Math.random(),amount,reason,kind,date:new Date().toISOString()});
}
function render(){
  document.getElementById("appTitle").textContent=state.title;
  document.getElementById("balance").textContent=fmt(state.balance);
  document.getElementById("currencyIcon").textContent=state.currencyIcon;
  document.getElementById("currencyName").textContent=state.currencyName;
  const list=document.getElementById("rewardsList");
  list.innerHTML="";
  document.getElementById("emptyRewards").classList.toggle("hidden",state.rewards.length>0);
  [...state.rewards].sort((a,b)=>a.price-b.price).forEach(r=>{
    const el=document.createElement("div");el.className="reward";
    el.innerHTML=`<div class="rewardInfo"><div class="rewardName">${esc(r.name)}</div><div class="rewardPrice">${fmt(r.price)} ${esc(state.currencyIcon)} ${esc(state.currencyName)}</div></div>
      <button class="redeem" ${state.balance<r.price?"disabled":""} data-redeem="${r.id}">Redeem</button>
      <button class="more" data-edit="${r.id}" aria-label="Edit">⋮</button>`;
    list.appendChild(el);
  });
  const h=document.getElementById("historyList");h.innerHTML="";
  document.getElementById("emptyHistory").classList.toggle("hidden",state.history.length>0);
  state.history.forEach(x=>{
    const el=document.createElement("div");el.className="historyItem";
    const positive=x.amount>0;
    el.innerHTML=`<div class="historyIcon">${x.kind==="reward"?"🎁":positive?"＋":"−"}</div>
      <div class="historyInfo"><div class="historyReason">${esc(x.reason||"Manual adjustment")}</div><div class="historyDate">${new Date(x.date).toLocaleString()}</div></div>
      <div class="${positive?"plus":"minus"}">${positive?"+":""}${fmt(x.amount)} ${esc(state.currencyIcon)}</div>`;
    h.appendChild(el);
  });
}
function openAmount(mode){
  amountMode=mode;
  document.getElementById("amountTitle").textContent=mode==="add"?"Add currency":"Spend currency";
  document.getElementById("amountInput").value="";
  document.getElementById("reasonInput").value="";
  document.getElementById("amountDialog").showModal();
}
document.getElementById("addBtn").onclick=()=>openAmount("add");
document.getElementById("subtractBtn").onclick=()=>openAmount("subtract");
document.getElementById("amountForm").onsubmit=e=>{
  e.preventDefault();
  const n=Math.floor(Number(document.getElementById("amountInput").value));
  const reason=document.getElementById("reasonInput").value.trim();
  if(!Number.isFinite(n)||n<1)return;
  if(amountMode==="subtract"&&n>state.balance){toast("Not enough currency");return}
  const delta=amountMode==="add"?n:-n;
  state.balance+=delta; addHistory(delta,reason, "manual"); save();
  document.getElementById("amountDialog").close();toast(delta>0?`+${fmt(n)} ${state.currencyIcon}`:`-${fmt(n)} ${state.currencyIcon}`);
};
document.getElementById("newRewardBtn").onclick=()=>openReward();
function openReward(id=null){
  editingRewardId=id;
  const r=state.rewards.find(x=>x.id===id);
  document.getElementById("rewardTitle").textContent=r?"Edit reward":"New reward";
  document.getElementById("rewardName").value=r?.name||"";
  document.getElementById("rewardPrice").value=r?.price||"";
  document.getElementById("rewardDialog").showModal();
}
document.getElementById("rewardForm").onsubmit=e=>{
  e.preventDefault();
  const name=document.getElementById("rewardName").value.trim();
  const price=Math.floor(Number(document.getElementById("rewardPrice").value));
  if(!name||!Number.isFinite(price)||price<1)return;
  if(editingRewardId){
    const r=state.rewards.find(x=>x.id===editingRewardId);r.name=name;r.price=price;
  }else state.rewards.push({id:Date.now(),name,price});
  save();document.getElementById("rewardDialog").close();toast("Reward saved");
};
document.getElementById("rewardsList").onclick=e=>{
  const redeem=e.target.closest("[data-redeem]"), edit=e.target.closest("[data-edit]");
  if(redeem){
    const r=state.rewards.find(x=>x.id==redeem.dataset.redeem);
    if(!r||state.balance<r.price)return;
    if(!confirm(`Redeem "${r.name}" for ${fmt(r.price)} ${state.currencyIcon}?`))return;
    state.balance-=r.price;addHistory(-r.price,`Redeemed: ${r.name}`,"reward");save();toast("Reward redeemed 🎉");
  }
  if(edit){
    const r=state.rewards.find(x=>x.id==edit.dataset.edit);
    if(!r)return;
    const action=prompt(`Edit "${r.name}"\n\nType DELETE to remove it, or press Cancel to edit.`, "");
    if(action==="DELETE"){state.rewards=state.rewards.filter(x=>x.id!==r.id);save();toast("Reward deleted")}
    else openReward(r.id);
  }
};
document.querySelectorAll(".tab").forEach(btn=>btn.onclick=()=>{
  document.querySelectorAll(".tab").forEach(x=>x.classList.remove("active"));btn.classList.add("active");
  document.getElementById("rewardsTab").classList.toggle("hidden",btn.dataset.tab!=="rewards");
  document.getElementById("historyTab").classList.toggle("hidden",btn.dataset.tab!=="history");
});
document.getElementById("settingsBtn").onclick=()=>{
  settingTitle.value=state.title;settingCurrencyName.value=state.currencyName;settingCurrencyIcon.value=state.currencyIcon;
  settingsDialog.showModal();
};
document.getElementById("settingsForm").onsubmit=e=>{
  e.preventDefault();
  state.title=settingTitle.value.trim()||"My Rewards";
  state.currencyName=settingCurrencyName.value.trim()||"Stars";
  state.currencyIcon=settingCurrencyIcon.value.trim()||"⭐";
  save();settingsDialog.close();toast("Settings saved");
};
document.getElementById("clearHistoryBtn").onclick=()=>{
  if(confirm("Clear the entire history?")){state.history=[];save();toast("History cleared")}
};
document.getElementById("resetBtn").onclick=()=>{
  if(confirm("Reset the app, including balance, rewards, and history?")){
    state=structuredClone(defaults);save();settingsDialog.close();toast("App reset");
  }
};
document.querySelectorAll("[data-close]").forEach(b=>b.onclick=()=>document.getElementById(b.dataset.close).close());
if("serviceWorker" in navigator) window.addEventListener("load",()=>navigator.serviceWorker.register("sw.js").catch(()=>{}));
render();

